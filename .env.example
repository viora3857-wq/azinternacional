# =============================================================================
# AZ Internacional — variáveis de ambiente
# Copie para .env (nunca versione o .env). Só o BACK-END lê este arquivo.
# O front-end não recebe nenhuma chave: tudo passa pela API.
# =============================================================================

# --- Geral --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origem pública do front (em produção, o domínio do Vercel). Vai nos links dos e-mails e na
# checagem de Origin (CSRF).
APP_URL=http://localhost:5173
# Saltos de proxy confiáveis à frente da API. Produção: Vercel (rewrite) + Render = 2. Define o IP real.
TRUST_PROXY_HOPS=0
# Pedidos às rotas públicas de auth/consentimento por IP a cada 15 minutos.
AUTH_RATE_LIMIT_PER_15MIN=30

# --- Banco (Supabase Postgres) ------------------------------------------------
# Local: postgres://postgres:postgres@localhost:5432/az_dev
# Supabase: Project Settings > Database > Connection string (pooler, modo "transaction", porta 6543).
# Crie o projeto em us-east-1, perto do Render (virginia).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/az_dev
# "require" em produção (obrigatório quando NODE_ENV=production).
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Sessão e criptografia ----------------------------------------------------
SESSION_TTL_HOURS=168
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Cifra os segredos de 2FA. Trocar esta chave invalida todos os 2FA já ativados.
DATA_ENCRYPTION_KEY=
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
# Usado para pseudonimizar IPs e e-mails em logs e limites de taxa.
HASH_PEPPER=

# --- E-mail (Brevo) -----------------------------------------------------------
# "dev" guarda os e-mails em memória e expõe em GET /api/dev/outbox (proibido em produção).
EMAIL_PROVIDER=dev
# Obrigatória com EMAIL_PROVIDER=brevo. Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Remetente precisa estar verificado na Brevo (domínio com SPF/DKIM).
EMAIL_FROM_ADDRESS=no-reply@az.example
EMAIL_FROM_NAME=AZ Internacional

# --- Testes -------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/az_test
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/az_e2e

# --- Front-end (build) --------------------------------------------------------
# "false" remove o aviso de rascunho das páginas legais (só depois da revisão jurídica).
VITE_LEGAL_DRAFT=true

# --- Fases seguintes (ainda NÃO lidas pelo código) ---------------------------
# Fase 2+: IA via OpenRouter. Modelo rápido = buscas simples; forte = provas, planos, correção, visão.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_FAST=
# OPENROUTER_MODEL_STRONG=
# AI_DAILY_TOKEN_LIMIT_PER_STUDENT=
# Fase 6: monitoramento.
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=az-internacional-api
